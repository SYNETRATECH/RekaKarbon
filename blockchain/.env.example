# KONFIGURASI SMART CONTRACT (PRODUCTION-GRADE)

# Jangan pernah membagikan file .env yang asli (pastikan .env masuk di .gitignore)
# Copy file ini menjadi `.env` sebelum memulai deployment di Mainnet/Testnet.

# Private Key dompet yang digunakan untuk Deployment
PRIVATE_KEY=0x_kunci_rahasia_anda_disini

# Local QBFT uses the non-validator RPC node. The generated file is created by
# `pnpm network:generate` and must not be committed.
QBFT_RPC_URL=http://127.0.0.1:8545
QBFT_CHAIN_ID=1338
QBFT_BESU_IMAGE=hyperledger/besu:26.8.1
# Canonical names used by the QBFT preflight and wallet-credit tooling. The QBFT_*
# aliases above remain supported by the network generator and existing local setup.
BESU_RPC_URL=http://127.0.0.1:8545
BESU_CHAIN_ID=1338
EXPECTED_VALIDATOR_COUNT=4
QBFT_SHARED_DIR=./networks/local-qbft/generated
QBFT_BLOCK_SAMPLE_MS=5000
QBFT_BLOCK_SAMPLE_ATTEMPTS=3
# The pinned generator image is kept separate because newer Besu images
# currently reject the generator output directory before writing the network.
QBFT_GENERATOR_IMAGE=hyperledger/besu:23.4.4
# Optional: local deployer balance in wei.
QBFT_PREFUND_BALANCE=1000000000000000000000000

# Optional local backend/relayer address.
BACKEND_ADDRESS=

# Deployment tooling defaults to verification. Change only during an approved window.
DEPLOYMENT_MODE=verify-existing
DEPLOYMENT_MANIFEST_PATH=deployment-info.json
BESU_GAS_PRICE_WEI=

# (Opsional) URL RPC untuk jaringan sungguhan (Misal: Infura, Alchemy, atau Public Besu Node Anda)
# MAINNET_RPC_URL=https://mainnet.infura.io/v3/API_KEY
