{
  "name": "@rekakarbon/blockchain",
  "version": "1.0.0",
  "description": "",
  "license": "Apache-2.0",
  "main": "index.js",
  "scripts": {
    "test": "hardhat test",
    "typecheck": "tsc --noEmit",
    "compile": "hardhat compile",
    "network:generate": "ts-node --project tsconfig.json scripts/network/generate-qbft-network.ts",
    "network:generate:force": "ts-node --project tsconfig.json scripts/network/generate-qbft-network.ts --force",
    "network:archive:legacy": "ts-node --project tsconfig.json scripts/network/archive-legacy-chain.ts",
    "network:up": "docker compose -p rekakarbon-qbft --env-file networks/local-qbft/generated/.env -f docker-compose.qbft.yml up -d",
    "network:down": "docker compose -p rekakarbon-qbft --env-file networks/local-qbft/generated/.env -f docker-compose.qbft.yml down",
    "network:logs": "docker compose -p rekakarbon-qbft --env-file networks/local-qbft/generated/.env -f docker-compose.qbft.yml logs -f --tail=100",
    "network:check": "ts-node --project tsconfig.json scripts/network/check-qbft-network.ts",
    "network:reset": "ts-node --project tsconfig.json scripts/network/reset-qbft-network.ts",
    "start-local-qbft": "pnpm network:up",
    "stop-local-qbft": "pnpm network:down",
    "check-network": "pnpm network:check",
    "show-network-status": "pnpm network:check",
    "reset-local-qbft": "pnpm network:reset",
    "qbft:preflight": "hardhat run scripts/preflight-qbft.ts --network besu_qbft",
    "qbft:fund-wallet-credit": "ts-node --project tsconfig.json scripts/fund-wallet-credit.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.0.5",
    "@openzeppelin/contracts": "5.0.0",
    "@types/chai": "^4.3.16",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.12.11",
    "chai": "^4.4.1",
    "ethers": "^6.10.0",
    "hardhat": "^2.22.8",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
