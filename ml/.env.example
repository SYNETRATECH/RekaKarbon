# RekaKarbon AI/ML Engine Environment Configuration Template
# Copy this file to .env for local development overrides.

# Global random state seed for data generators, pipeline estimators, and tests
RANDOM_STATE=20260830

# ===== CONTINUOUS RETRAINING CONFIGURATION =====
# Path to the production feedback pool CSV
ML_FEEDBACK_POOL_PATH=data/production/feedback_pool.csv

# Minimum real records before retraining can be triggered
ML_MIN_REAL_RECORDS=100

# Blend weight for real data in merged training set (0.0 to 1.0)
ML_REAL_BLEND_WEIGHT=0.20

# PSI threshold for drift detection trigger
ML_PSI_DRIFT_THRESHOLD=0.20

# PSI threshold for drift warning
ML_PSI_WARNING_THRESHOLD=0.10

# Directory to store model backups before artifact swap
ML_MODEL_BACKUP_DIR=models/backup

# Path to the append-only retraining audit log
ML_RETRAINING_LOG_PATH=models/retraining_log.jsonl

# Number of days between scheduled retraining runs
ML_SCHEDULED_RETRAIN_DAYS=7


