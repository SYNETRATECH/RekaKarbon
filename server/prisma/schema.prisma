enum EmissionReportStatus {
  DRAFT
  SUBMITTED
  REVISION_REQUIRED
  APPROVED
  REJECTED
}

enum EmissionReportAuditAction {
  SUBMITTED
  REVISION_REQUESTED
  RESUBMITTED
  APPROVED
}

enum ReportMethod {
  UPLOAD
  CALCULATOR
}

model EmissionReport {
  id                    String                       @id @default(uuid()) @db.Uuid
  companyId             String                       @map("company_id") @db.Uuid
  year                  Int
  totalEmissionsTco2e   Decimal                      @map("total_emissions_tco2e") @db.Decimal(14, 2)
  merkleRoot            String                       @map("merkle_root") @db.Text
  blockchainTxHash      String?                      @map("blockchain_tx_hash") @db.Text
  blockchainReportId    BigInt?                      @map("blockchain_report_id")
  status                EmissionReportStatus         @default(SUBMITTED)
  reportMethod          ReportMethod                 @default(UPLOAD) @map("report_method")
  sector                String?                      @db.Text
  calculationData       Json?                        @map("calculation_data")
  submittedAt           DateTime                     @default(now()) @map("submitted_at") @db.Timestamptz
  auditedByUserId       String?                      @map("audited_by_user_id") @db.Uuid
  auditorNotes          String?                      @map("auditor_notes") @db.Text
  auditedAt             DateTime?                    @map("audited_at") @db.Timestamptz
  auditBlockchainTxHash String?                      @map("audit_blockchain_tx_hash") @db.Text
  auditAnchorStatus     PtbaeBlockchainAnchorStatus? @map("audit_anchor_status")
  revisionNumber        Int                          @default(0) @map("revision_number")
  createdAt             DateTime                     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime                     @updatedAt @map("updated_at") @db.Timestamptz

  company           Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  auditor           User?                      @relation("AuditorReports", fields: [auditedByUserId], references: [id])
  files             StoredFile[]
  ptbaeApplications PtbaeApplication[]
  auditEvents       EmissionReportAuditEvent[]

  @@unique([companyId, year])
  @@index([status])
  @@map("emission_reports")
}

model EmissionReportAuditEvent {
  id               String                    @id @default(uuid()) @db.Uuid
  emissionReportId String                    @map("emission_report_id") @db.Uuid
  actorUserId      String                    @map("actor_user_id") @db.Uuid
  action           EmissionReportAuditAction
  fromStatus       EmissionReportStatus?     @map("from_status")
  toStatus         EmissionReportStatus      @map("to_status")
  notes            String?                   @db.Text
  merkleRoot       String?                   @map("merkle_root") @db.Text
  blockchainTxHash String?                   @map("blockchain_tx_hash") @db.Text
  createdAt        DateTime                  @default(now()) @map("created_at") @db.Timestamptz

  emissionReport EmissionReport @relation(fields: [emissionReportId], references: [id], onDelete: Cascade)
  actor          User           @relation("EmissionReportAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([emissionReportId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("emission_report_audit_events")
}

model StoredFile {
  id               String       @id @default(uuid()) @db.Uuid
  uploadedByUserId String?      @map("uploaded_by_user_id") @db.Uuid
  emissionReportId String?      @map("emission_report_id") @db.Uuid
  originalFileName String       @map("original_file_name") @db.Text
  mimeType         String       @map("mime_type") @db.Text
  fileSizeBytes    BigInt       @map("file_size_bytes")
  storageKey       String       @unique @map("storage_key") @db.Text
  accessUrl        String       @map("access_url") @db.Text
  contentHash      String?      @map("content_hash") @db.Text
  hashAlgorithm    String?      @map("hash_algorithm") @db.Text
  hashComputedAt   DateTime?    @map("hash_computed_at") @db.Timestamptz
  category         FileCategory @default(EMISSION_REPORT)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz

  uploadedByUser            User?                      @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  emissionReport            EmissionReport?            @relation(fields: [emissionReportId], references: [id], onDelete: SetNull)
  missionOrthos             DroneMission[]             @relation("MissionOrthoFile")
  missionPointclouds        DroneMission[]             @relation("MissionPointcloudFile")
  ptbaeApplicationDocuments PtbaeApplicationDocument[]

  @@index([uploadedByUserId])
  @@index([emissionReportId])
  @@index([category])
  @@map("stored_files")
}

model SystemNotification {
  id              String           @id @default(uuid()) @db.Uuid
  recipientUserId String?          @map("recipient_user_id") @db.Uuid
  title           String           @db.Text
  message         String           @db.Text
  type            NotificationType @default(INFO)
