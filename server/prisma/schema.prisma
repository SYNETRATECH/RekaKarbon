// server/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------
// ENUMS
// ---------------------------------------------------------

enum Role {
  superadmin
  regulator
  auditor
  ministry
  emitter
  kth
  buyer
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum KybCategory {
  CORPORATE
  KTH_COOPERATIVE
  VERIFIER_INSTITUTION
  GOVERNMENT_AGENCY
}

enum KybStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PtbaeStatus {
  LEGACY
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum PtbaeApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_AUDIT
  REVISION_REQUIRED
  MINISTRY_REVIEW
  APPROVAL_PROCESSING
  APPROVED
  REJECTED
  EXPIRED
}

enum PtbaeDocumentType {
  TECHNICAL_DATA
  PRODUCTION_PLAN
  BASELINE_EMISSION
  MITIGATION_PLAN
  SUPPORTING_DOCUMENT
  DECISION_DOCUMENT
}

enum PtbaeApplicationEventType {
  SUBMITTED
  RESUBMITTED
  AUDIT_APPROVED
  REVISION_REQUESTED
  MINISTRY_APPROVED
  MINISTRY_REJECTED
  REVOKED
}

enum PtbaeBlockchainAnchorType {
  APPLICATION_SUBMISSION
  AUDIT_DECISION
  MINISTRY_DECISION
  REVOCATION
}

enum PtbaeBlockchainAnchorStatus {
  PENDING
  PROCESSING
  CONFIRMED
  FAILED
}

enum ComplianceRating {
  COMPLIANT
  WARNING
  NON_COMPLIANT
}

enum SensorStatus {
  ONLINE
  OFFLINE
  CALIBRATING
  FAULT
}

enum EcosystemType {
  MANGROVE_BLUE_CARBON
  PEATLAND_RESTORATION
  AGROFORESTRY
  TROPICAL_RAINFOREST
}

enum ProjectStatus {
  DRAFT
  ACTIVE_DMRV
  AUDITED
  MINTED
}

enum StageStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum AnomalyType {
  CEMS_ENERGY_CORRELATION
  SATELLITE_CHM_DEFICIT
  QUOTA_CAP_BREACH
  SPATIAL_ENCROACHMENT
}

enum SeverityLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AuditStatus {
  PENDING_REVIEW
  UNDER_INVESTIGATION
  VERIFIED
  FLAGGED_FRAUD
}

enum MissionStatus {
  SCHEDULED
  COMPLETED
  PROCESSING
  FAILED
}

enum ListingStatus {
  DRAFT
  AWAITING_KTH_CONFIRMATION
  ACTIVATING
  ACTIVE
  PARTIALLY_FILLED
  FILLED
  FROZEN
  CANCELLED
  BLOCKCHAIN_FAILED
}

enum OrderStatus {
  PENDING
  PENDING_BLOCKCHAIN
  COMPLETED
  FAILED
}

enum BursaAttestationStatus {
  PENDING
  CONFIRMED
  REVISION_REQUIRED
}

enum BursaSettlementStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum MultiSigTxType {
  MINT_CREDIT
  DISBURSE_INCENTIVE
  BURN_TOKEN_FRACTION
  TREASURY_TRANSFER
}

enum MultiSigStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
}

enum TaxAssessmentStatus {
  CALCULATED
  STP_ISSUED
  PAID
  OVERDUE
}

enum PaymentStatus {
  UNPAID
  PAID
  OVERDUE
}

enum FileCategory {
  EMISSION_REPORT
  PTBAE_APPLICATION
  PTBAE_DECISION
  LEGAL_SK
  DRONE_ORTHO
  DRONE_LIDAR
  SPATIAL_GEOJSON
  AUDIT_PROOF
}

enum NotificationType {
  CAP_BREACH
  DMRV_ANOMALY
  MULTISIG_ACTION
  MINT_CONFIRMED
  INFO
}

enum PriorityLevel {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

// ---------------------------------------------------------
// 1. IDENTITY & ROLES
// ---------------------------------------------------------

model User {
  id            String     @id @default(uuid()) @db.Uuid
  email         String     @unique @db.Text
  passwordHash  String     @map("password_hash") @db.Text
  fullName      String?    @map("full_name") @db.Text
  role          Role       @default(buyer)
  walletAddress String?    @map("wallet_address") @db.Text
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  kybProfile                      KybProfile?
  verifiedKybProfiles             KybProfile[]               @relation("KybVerifier")
  companies                       Company[]
  bursaListings                   BursaListing[]             @relation("SellerListings")
  bursaOrders                     BursaOrder[]               @relation("BuyerOrders")
  multisigRequests                MultiSigRequest[]          @relation("ApplicantRequests")
  multisigSignatures              MultiSigSignature[]
  uploadedFiles                   StoredFile[]
  systemNotifications             SystemNotification[]
  pushSubscriptions               WebPushSubscription[]
  auditedReports                  EmissionReport[]           @relation("AuditorReports")
  emissionReportAuditEvents       EmissionReportAuditEvent[] @relation("EmissionReportAuditActor")
  submittedPtbaeApplications      PtbaeApplication[]         @relation("PtbaeApplicationSubmitter")
  auditedPtbaeApplications        PtbaeApplication[]         @relation("PtbaeApplicationAuditor")
  decidedPtbaeApplications        PtbaeApplication[]         @relation("PtbaeApplicationDecider")
  createdPtbaeApplicationVersions PtbaeApplicationVersion[]  @relation("PtbaeApplicationVersionCreator")
  issuedPtbaeAllocations          PtbaeAllocation[]          @relation("PtbaeAllocationIssuer")
  assignedForestProjects           ForestProject[]           @relation("ForestProjectAuditor")

  @@map("users")
}

model KybProfile {
  id                 String      @id @default(uuid()) @db.Uuid
  userId             String      @unique @map("user_id") @db.Uuid
  entityName         String      @map("entity_name") @db.Text
  category           KybCategory @default(CORPORATE)
  npwp               String?     @db.Text
  registrationNumber String?     @map("registration_number") @db.Text
  signatoryName      String?     @map("signatory_name") @db.Text
  verificationStatus KybStatus   @default(PENDING) @map("verification_status")
  verifiedAt         DateTime?   @map("verified_at") @db.Timestamptz
  verifiedByUserId   String?     @map("verified_by_user_id") @db.Uuid
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  user           User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifiedByUser User? @relation("KybVerifier", fields: [verifiedByUserId], references: [id])

  @@index([verificationStatus])
  @@map("kyb_profiles")
}

// ---------------------------------------------------------
// 2. CORPORATE EMITTERS, CEMS & TELEMETRY
// ---------------------------------------------------------

model Company {
  id                      String           @id @default(uuid()) @db.Uuid
  userId                  String?          @map("user_id") @db.Uuid
  name                    String           @db.Text
  sector                  String           @db.Text
  region                  String           @db.Text
  latitude                Float            @db.DoublePrecision
  longitude               Float            @db.DoublePrecision
  emissionCapTco2e        Decimal          @map("emission_cap_tco2e") @db.Decimal(14, 2)
  actualEmissionTco2e     Decimal          @map("actual_emission_tco2e") @db.Decimal(14, 2)
  carbonDeficitTco2e      Decimal          @default(0) @map("carbon_deficit_tco2e") @db.Decimal(14, 2)
  offsetCostIdr           Decimal          @default(0) @map("offset_cost_idr") @db.Decimal(16, 2)
  complianceRating        ComplianceRating @default(COMPLIANT) @map("compliance_rating")
  auditDate               DateTime?        @map("audit_date") @db.Date
  paymentDeadline         DateTime?        @map("payment_deadline") @db.Date
  stackSensorsDescription String?          @map("stack_sensors_description") @db.Text
  picAuditor              String?          @map("pic_auditor") @db.Text
  description             String?          @db.Text
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  user                 User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  smokestacks          Smokestack[]
  cemsTelemetryLogs    CemsTelemetryLog[]
  auditAnomalies       AuditAnomaly[]
  carbonTaxAssessments CarbonTaxAssessment[]
  stpInvoices          StpInvoice[]
  emissionReports      EmissionReport[]
  ptbaeAllocations     PtbaeAllocation[]
  ptbaeApplications    PtbaeApplication[]

  @@index([complianceRating])
  @@index([region])
  @@map("companies")
}

model PtbaeAllocation {
  id                   String      @id @default(uuid()) @db.Uuid
  companyId            String      @map("company_id") @db.Uuid
  applicationId        String?     @unique @map("application_id") @db.Uuid
  complianceYear       Int         @map("compliance_year")
  quotaTco2e           Decimal     @map("quota_tco2e") @db.Decimal(14, 2)
  sourceDocument       String?     @map("source_document") @db.Text
  status               PtbaeStatus @default(PENDING)
  assignedAt           DateTime?   @map("assigned_at") @db.Timestamptz
  verifiedAt           DateTime?   @map("verified_at") @db.Timestamptz
  documentNumber       String?     @map("document_number") @db.Text
  issuedByUserId       String?     @map("issued_by_user_id") @db.Uuid
  effectiveFrom        DateTime?   @map("effective_from") @db.Date
  effectiveUntil       DateTime?   @map("effective_until") @db.Date
  blockchainTxHash     String?     @map("blockchain_tx_hash") @db.Text
  issuanceTxHash       String?     @map("issuance_tx_hash") @db.Text
  decisionMerkleRoot   String?     @map("decision_merkle_root") @db.Text
  applicationVersionId String?     @unique @map("application_version_id") @db.Uuid
  notes                String?     @db.Text
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  company            Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  application        PtbaeApplication?        @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  applicationVersion PtbaeApplicationVersion? @relation(fields: [applicationVersionId], references: [id], onDelete: SetNull)
  issuedBy           User?                    @relation("PtbaeAllocationIssuer", fields: [issuedByUserId], references: [id], onDelete: SetNull)

  @@unique([companyId, complianceYear])
  @@index([complianceYear, status])
  @@index([issuedByUserId])
  @@map("ptbae_allocations")
}

model PtbaeApplication {
  id                       String                       @id @default(uuid()) @db.Uuid
  companyId                String                       @map("company_id") @db.Uuid
  emissionReportId         String?                      @map("emission_report_id") @db.Uuid
  submittedByUserId        String                       @map("submitted_by_user_id") @db.Uuid
  complianceYear           Int                          @map("compliance_year")
  status                   PtbaeApplicationStatus       @default(DRAFT)
  facilityName             String                       @map("facility_name") @db.Text
  technicalData            Json                         @map("technical_data")
  productionData           Json                         @map("production_data")
  baselineEmissionTco2e    Decimal                      @map("baseline_emission_tco2e") @db.Decimal(14, 2)
  mitigationPlan           String                       @map("mitigation_plan") @db.Text
  emitterNotes             String?                      @map("emitter_notes") @db.Text
  submittedAt              DateTime?                    @map("submitted_at") @db.Timestamptz
  auditedByUserId          String?                      @map("audited_by_user_id") @db.Uuid
  auditedAt                DateTime?                    @map("audited_at") @db.Timestamptz
  auditorNotes             String?                      @map("auditor_notes") @db.Text
  ministryDecisionByUserId String?                      @map("ministry_decision_by_user_id") @db.Uuid
  ministryDecidedAt        DateTime?                    @map("ministry_decided_at") @db.Timestamptz
  ministryNotes            String?                      @map("ministry_notes") @db.Text
  currentVersion           Int                          @default(0) @map("current_version")
  latestMerkleRoot         String?                      @map("latest_merkle_root") @db.Text
  latestAnchorStatus       PtbaeBlockchainAnchorStatus? @map("latest_anchor_status")
  latestAnchoredAt         DateTime?                    @map("latest_anchored_at") @db.Timestamptz
  createdAt                DateTime                     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime                     @updatedAt @map("updated_at") @db.Timestamptz

  company            Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  emissionReport     EmissionReport?            @relation(fields: [emissionReportId], references: [id], onDelete: SetNull)
  submittedBy        User                       @relation("PtbaeApplicationSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  auditedBy          User?                      @relation("PtbaeApplicationAuditor", fields: [auditedByUserId], references: [id], onDelete: SetNull)
  ministryDecisionBy User?                      @relation("PtbaeApplicationDecider", fields: [ministryDecisionByUserId], references: [id], onDelete: SetNull)
  documents          PtbaeApplicationDocument[]
  allocation         PtbaeAllocation?
  versions           PtbaeApplicationVersion[]
  blockchainAnchors  PtbaeBlockchainAnchor[]

  @@unique([companyId, complianceYear])
  @@index([status, complianceYear])
  @@index([submittedByUserId])
  @@index([auditedByUserId])
  @@index([ministryDecisionByUserId])
  @@map("ptbae_applications")
}

model PtbaeApplicationVersion {
  id                 String                    @id @default(uuid()) @db.Uuid
  applicationId      String                    @map("application_id") @db.Uuid
  version            Int
  eventType          PtbaeApplicationEventType @map("event_type")
  status             PtbaeApplicationStatus
  snapshotJson       Json                      @map("snapshot_json")
  snapshotHash       String                    @map("snapshot_hash") @db.Text
  merkleRoot         String                    @map("merkle_root") @db.Text
  previousMerkleRoot String?                   @map("previous_merkle_root") @db.Text
  createdByUserId    String                    @map("created_by_user_id") @db.Uuid
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz

  application       PtbaeApplication        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdBy         User                    @relation("PtbaeApplicationVersionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  leaves            PtbaeMerkleLeaf[]
  blockchainAnchors PtbaeBlockchainAnchor[]
  allocation        PtbaeAllocation?

  @@unique([applicationId, version])
  @@index([applicationId, createdAt])
  @@index([createdByUserId])
  @@index([merkleRoot])
  @@map("ptbae_application_versions")
}

model PtbaeMerkleLeaf {
  id                   String   @id @default(uuid()) @db.Uuid
  applicationVersionId String   @map("application_version_id") @db.Uuid
  leafKey              String   @map("leaf_key") @db.Text
  leafType             String   @map("leaf_type") @db.Text
  contentHash          String   @map("content_hash") @db.Text
  leafHash             String   @map("leaf_hash") @db.Text
  leafOrder            Int      @map("leaf_order")
  proofJson            Json?    @map("proof_json")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz

  applicationVersion PtbaeApplicationVersion @relation(fields: [applicationVersionId], references: [id], onDelete: Cascade)

  @@unique([applicationVersionId, leafKey])
  @@index([applicationVersionId, leafOrder])
  @@index([leafHash])
  @@map("ptbae_merkle_leaves")
}

model PtbaeBlockchainAnchor {
  id                   String                      @id @default(uuid()) @db.Uuid
  applicationId        String                      @map("application_id") @db.Uuid
  applicationVersionId String                      @map("application_version_id") @db.Uuid
  anchorType           PtbaeBlockchainAnchorType   @map("anchor_type")
  merkleRoot           String                      @map("merkle_root") @db.Text
  status               PtbaeBlockchainAnchorStatus @default(PENDING)
  transactionHash      String?                     @map("transaction_hash") @db.Text
  blockNumber          BigInt?                     @map("block_number")
  contractAddress      String?                     @map("contract_address") @db.Text
  chainId              Int?                        @map("chain_id")
  retryCount           Int                         @default(0) @map("retry_count")
  lastError            String?                     @map("last_error") @db.Text
  nextRetryAt          DateTime?                   @map("next_retry_at") @db.Timestamptz
  submittedAt          DateTime?                   @map("submitted_at") @db.Timestamptz
  confirmedAt          DateTime?                   @map("confirmed_at") @db.Timestamptz
  createdAt            DateTime                    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime                    @updatedAt @map("updated_at") @db.Timestamptz

  application        PtbaeApplication        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationVersion PtbaeApplicationVersion @relation(fields: [applicationVersionId], references: [id], onDelete: Cascade)

  @@unique([applicationVersionId, anchorType])
  @@index([applicationId, createdAt])
  @@index([status, nextRetryAt])
  @@index([transactionHash])
  @@map("ptbae_blockchain_anchors")
}

model PtbaeApplicationDocument {
  id            String            @id @default(uuid()) @db.Uuid
  applicationId String            @map("application_id") @db.Uuid
  storedFileId  String            @unique @map("stored_file_id") @db.Uuid
  documentType  PtbaeDocumentType @map("document_type")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz

  application PtbaeApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  storedFile  StoredFile       @relation(fields: [storedFileId], references: [id], onDelete: Cascade)

  @@index([applicationId, documentType])
  @@map("ptbae_application_documents")
}

model Smokestack {
  id                 String       @id @default(uuid()) @db.Uuid
  companyId          String       @map("company_id") @db.Uuid
  stackCode          String       @map("stack_code") @db.Text
  sensorFacilityName String       @map("sensor_facility_name") @db.Text
  status             SensorStatus @default(ONLINE)
  lastTelemetryAt    DateTime?    @map("last_telemetry_at") @db.Timestamptz
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cemsTelemetryLogs CemsTelemetryLog[]

  @@index([companyId])
  @@map("smokestacks")
}

model CemsTelemetryLog {
  id            BigInt   @id @default(autoincrement())
  companyId     String   @map("company_id") @db.Uuid
  smokestackId  String?  @map("smokestack_id") @db.Uuid
  co2Ppm        Decimal  @map("co2_ppm") @db.Decimal(10, 2)
  so2MgM3       Decimal  @map("so2_mg_m3") @db.Decimal(10, 2)
  noxMgM3       Decimal  @map("nox_mg_m3") @db.Decimal(10, 2)
  flowRateM3Sec Decimal  @map("flow_rate_m3_sec") @db.Decimal(8, 2)
  temperatureC  Decimal  @map("temperature_c") @db.Decimal(6, 2)
  isAnomaly     Boolean  @default(false) @map("is_anomaly")
  recordedAt    DateTime @default(now()) @map("recorded_at") @db.Timestamptz

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  smokestack Smokestack? @relation(fields: [smokestackId], references: [id], onDelete: SetNull)

  @@index([companyId, recordedAt(sort: Desc)])
  @@index([smokestackId, recordedAt(sort: Desc)])
  @@map("cems_telemetry_logs")
}

// ---------------------------------------------------------
// 3. SOCIAL FORESTRY, KTH GROUPS & PROJECTS
// ---------------------------------------------------------

model NationalForestRegion {
  id                       String   @id @default(uuid()) @db.Uuid
  regionName               String   @map("region_name") @db.Text
  areaHectares             Decimal  @map("area_hectares") @db.Decimal(14, 2)
  carbonSequestrationTco2e Decimal  @map("carbon_sequestration_tco2e") @db.Decimal(14, 2)
  fundingDisbursedIdr      Decimal  @map("funding_disbursed_idr") @db.Decimal(16, 2)
  forestHealthPercent      Decimal  @map("forest_health_percent") @db.Decimal(5, 2)
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz

  projects ForestProject[]

  @@map("national_forest_regions")
}

model KthGroup {
  id                        String    @id @default(uuid()) @db.Uuid
  groupName                 String    @map("group_name") @db.Text
  leaderName                String    @map("leader_name") @db.Text
  memberCount               Int       @map("member_count")
  location                  String    @db.Text
  registrationNumber        String?   @map("registration_number") @db.Text
  walletAddress             String?   @map("wallet_address") @db.Text
  totalIncentiveReceivedIdr Decimal   @default(0) @map("total_incentive_received_idr") @db.Decimal(16, 2)
  kybStatus                 KybStatus @default(PENDING) @map("kyb_status")
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                 DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  projects                 ForestProject[]
  disbursements            KthIncentiveDisbursement[]
  bursaListings            BursaListing[]
  bursaListingAttestations BursaListingAttestation[]

  @@map("kth_groups")
}

model ForestProject {
  id                       String        @id @default(uuid()) @db.Uuid
  regionId                 String        @map("region_id") @db.Uuid
  kthGroupId               String?       @map("kth_group_id") @db.Uuid
  projectName              String        @map("project_name") @db.Text
  ecosystemType            EcosystemType @default(MANGROVE_BLUE_CARBON) @map("ecosystem_type")
  province                 String        @db.Text
  latitude                 Float         @db.DoublePrecision
  longitude                Float         @db.DoublePrecision
  areaHectares             Decimal       @map("area_hectares") @db.Decimal(12, 2)
  targetSequestrationTco2e Decimal       @map("target_sequestration_tco2e") @db.Decimal(14, 2)
  actualSequestrationTco2e Decimal       @map("actual_sequestration_tco2e") @db.Decimal(14, 2)
  carbonStockTco2e         Decimal       @map("carbon_stock_tco2e") @db.Decimal(14, 2)
  carbonPricePerTonIdr     Decimal       @default(260000) @map("carbon_price_per_ton_idr") @db.Decimal(12, 2)
  ndviScore                Decimal       @default(0.75) @map("ndvi_score") @db.Decimal(4, 3)
  eviScore                 Decimal       @default(0.60) @map("evi_score") @db.Decimal(4, 3)
  survivalRatePercent      Decimal       @default(85.0) @map("survival_rate_percent") @db.Decimal(5, 2)
  canopyHeightMeters       Decimal       @default(1.50) @map("canopy_height_meters") @db.Decimal(6, 2)
  budgetTotalIdr           Decimal       @default(0) @map("budget_total_idr") @db.Decimal(16, 2)
  budgetDisbursedIdr       Decimal       @default(0) @map("budget_disbursed_idr") @db.Decimal(16, 2)
  status                   ProjectStatus @default(ACTIVE_DMRV)
  auditorUserId            String?       @map("auditor_user_id") @db.Uuid
  auditorAssignedAt        DateTime?     @map("auditor_assigned_at") @db.Timestamptz
  auditorNotes             String?       @map("auditor_notes") @db.Text
  auditedAt                DateTime?     @map("audited_at") @db.Timestamptz
  speCertificateId         String?       @map("spe_certificate_id") @db.Text
  coordinatesJson          Json?         @map("coordinates_json")
  bufferAllocatedPercent   Decimal       @default(8.0) @map("buffer_allocated_percent") @db.Decimal(5, 2)
  bufferUsedPercent        Decimal       @default(0.0) @map("buffer_used_percent") @db.Decimal(5, 2)
  trendDataJson            Json?         @map("trend_data_json")
  createdAt                DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  region           NationalForestRegion       @relation(fields: [regionId], references: [id])
  kthGroup         KthGroup?                  @relation(fields: [kthGroupId], references: [id], onDelete: SetNull)
  auditor          User?                       @relation("ForestProjectAuditor", fields: [auditorUserId], references: [id], onDelete: SetNull)
  stages           ProjectStage[]
  droneMissions    DroneMission[]
  forestSensorLogs ForestSensorTelemetryLog[]
  carbonTokens     CarbonToken[]
  disbursements    KthIncentiveDisbursement[]
  bursaListings    BursaListing[]

  @@index([regionId])
  @@index([kthGroupId])
