# ==============================================================================
# RekaKarbon Backend Server Environment Variables (.env)
# ==============================================================================

# Server Port
PORT=3000

# Node Environment ('development' | 'test' | 'production')
NODE_ENV=development

# PostgreSQL Database Connection URL (Prisma ORM)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rekakarbon?schema=public"

# Cross-Origin Resource Sharing (CORS) Allowed Origins
# Comma-separated list of permitted frontend origins for distributed deployments.
# Use '*' only for open development or specific staging environments.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://app.rekakarbon.id"

# JSON Web Token (JWT) Secret Key for Authentication
JWT_SECRET="rekakarbon_production_jwt_secret_key_change_me_in_prod"
JWT_EXPIRES_IN="7d"

# Blockchain Network Configuration (Hyperledger Besu / EVM Node)
BESU_RPC_URL="http://localhost:8545"
BESU_CHAIN_ID=1337
OPERATOR_PRIVATE_KEY=""
CARBON_TOKEN_CONTRACT_ADDRESS=""

# Object Storage / S3 Configuration (Optional for cloud storage)
STORAGE_ENDPOINT="https://storage.rekakarbon.id"
STORAGE_BUCKET="rekakarbon-documents"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
