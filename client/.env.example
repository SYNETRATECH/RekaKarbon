# ==============================================================================
# RekaKarbon Frontend Client Environment Variables (.env)
# ==============================================================================

# Toggle Mock vs Live API Repositories
# Set to 'false' to connect to live NestJS backend; 'true' to use local mock fixtures.
VITE_USE_MOCK_DATA=false

# Backend API Base URL
# - In local dev with Vite Proxy: leave empty '' or use '/api'
# - In standalone multi-server deployment: provide full backend URL (e.g. 'http://localhost:3000' or 'https://api.rekakarbon.farrelad.com')
VITE_API_BASE_URL="http://localhost:3000"

# Application Base URL path (defaults to '/')
BASE_URL="/"

# Mapbox / Spatial Map Tile Token (Optional for external satellite base layers)
VITE_MAP_TILE_TOKEN=""