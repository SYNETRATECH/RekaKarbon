{
  "name": "RekaKarbon",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "24.15.0",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "dev": "pnpm dev:server & pnpm dev:client",
    "build": "pnpm client:build && pnpm server:build",
    "start:prod": "pnpm build && (pnpm server:prod & pnpm client:preview)",
    "format:check": "prettier --check client server blockchain",
    "format:write": "prettier --write client server blockchain",
    "client:dev": "pnpm --filter ./client dev",
    "client:build": "pnpm --filter ./client build",
    "client:preview": "pnpm --filter ./client preview",
    "client:lint": "pnpm --filter ./client lint",
    "client:typecheck": "pnpm --filter ./client typecheck",
    "client:test": "pnpm --filter ./client test",
    "server:dev": "pnpm --filter ./server start:dev",
    "server:build": "pnpm --filter ./server build",
    "server:prod": "pnpm --filter ./server start:prod",
    "server:lint": "pnpm --filter ./server lint",
    "server:typecheck": "pnpm --filter ./server typecheck",
    "server:test": "pnpm --filter ./server test",
    "blockchain:test": "pnpm --filter ./blockchain test",
    "blockchain:compile": "pnpm --filter ./blockchain compile",
    "blockchain:typecheck": "pnpm --filter ./blockchain typecheck",
    "ml:lint": "poetry --directory ./ml run ruff check .",
    "ml:format:check": "poetry --directory ./ml run ruff format --check .",
    "ml:format:write": "poetry --directory ./ml run ruff format .",
    "ml:typecheck": "poetry --directory ./ml run mypy src tests app.py",
    "ml:test": "poetry --directory ./ml run pytest",
    "ml:train": "poetry --directory ./ml run train",
    "ml:preprocess": "poetry --directory ./ml run preprocess",
    "ml:eval": "poetry --directory ./ml run eval",
    "db:generate": "pnpm --filter ./server prisma:generate",
    "db:migrate": "pnpm --filter ./server prisma:migrate",
    "db:deploy": "pnpm --filter ./server prisma:migrate:deploy",
    "db:status": "pnpm --filter ./server prisma:migrate:status",
    "db:seed": "pnpm --filter ./server prisma:seed",
    "db:studio": "pnpm --filter ./server prisma:studio",
    "typecheck": "pnpm client:typecheck && pnpm server:typecheck && pnpm blockchain:typecheck && pnpm ml:typecheck",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "3.9.6"
  }
}
