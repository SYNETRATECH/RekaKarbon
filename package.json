{
  "name": "RekaKarbon",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev:client": "pnpm --filter @rekakarbon/client dev",
    "build:client": "pnpm --filter @rekakarbon/client build",
    "dev:server": "pnpm --filter server start:dev",
    "build:server": "pnpm --filter server build",
    "dev": "pnpm dev:server & pnpm dev:client",
    "build": "pnpm build:client && pnpm build:server",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.10.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "3.9.6"
  }
}
